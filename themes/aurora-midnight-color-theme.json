	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6A9955",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keywords and control flow",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": {
				"foreground": "#C586C0"
			}
		},
		{
			"name": "Operators and punctuation",
			"scope": [
				"keyword.operator",
				"punctuation",
				"meta.delimiter"
			],
			"settings": {
				"foreground": "#D4D4D4"
			}
		},
		{
			"name": "Strings",
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#CE9178"
			}
		},
		{
			"name": "String escapes",
			"scope": [
				"constant.character.escape",
				"string constant.character"
			],
			"settings": {
				"foreground": "#D7BA7D"
			}
		},
		{
			"name": "Numbers",
			"scope": [
				"constant.numeric"
			],
			"settings": {
				"foreground": "#B5CEA8"
			}
		},
		{
			"name": "Language constants",
			"scope": [
				"constant.language",
				"support.constant"
			],
			"settings": {
				"foreground": "#569CD6"
			}
		},
		{
			"name": "Boolean literals",
			"scope": [
				"constant.language.boolean"
			],
			"settings": {
				"foreground": "#569CD6"
			}
		},
		{
			"name": "Null and undefined",
			"scope": [
				"constant.language.null",
				"constant.language.undefined"
			],
			"settings": {
				"foreground": "#569CD6"
			}
		},
		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"support.function",
				"variable.function"
			],
			"settings": {
				"foreground": "#DCDCAA"
			}
		},
		{
			"name": "Methods",
			"scope": [
				"entity.name.function.member",
				"entity.name.method",
				"entity.name.method.js",
				"entity.name.function.java"
			],
			"settings": {
				"foreground": "#82A9FF"
			}
		},
		{
			"name": "Parameters",
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "Local variables",
			"scope": [
				"variable.other.readwrite",
				"variable.other.local"
			],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"name": "Instance variables",
			"scope": [
				"variable.other.member",
				"variable.other.property"
			],
			"settings": {
				"foreground": "#80C7FF"
			}
		},
		{
			"name": "Language variables",
			"scope": [
				"variable.language"
			],
			"settings": {
				"foreground": "#569CD6"
			}
		},
		{
			"name": "Constants",
			"scope": [
				"variable.other.constant",
				"constant.other"
			],
			"settings": {
				"foreground": "#4FC1FF"
			}
		},
		{
			"name": "Classes and types",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "Interfaces",
			"scope": [
